{
  "components": {
    "schemas": {
      "Battlecard": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "title": "Claims",
            "type": "array"
          },
          "finished_at": {
            "format": "date-time",
            "title": "Finished At",
            "type": "string"
          },
          "rival": {
            "title": "Rival",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "total_count": {
            "title": "Total Count",
            "type": "integer"
          },
          "verified_count": {
            "title": "Verified Count",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "subject",
          "rival",
          "claims",
          "verified_count",
          "total_count",
          "started_at",
          "finished_at"
        ],
        "title": "Battlecard",
        "type": "object"
      },
      "Claim": {
        "additionalProperties": false,
        "properties": {
          "about": {
            "enum": [
              "subject",
              "rival"
            ],
            "title": "About",
            "type": "string"
          },
          "domain": {
            "enum": [
              "pricing",
              "positioning_seo",
              "news_social",
              "product"
            ],
            "title": "Domain",
            "type": "string"
          },
          "receipt": {
            "discriminator": {
              "mapping": {
                "quote": "#/components/schemas/QuoteReceipt",
                "search": "#/components/schemas/SearchReceipt"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/QuoteReceipt"
              },
              {
                "$ref": "#/components/schemas/SearchReceipt"
              }
            ],
            "title": "Receipt"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "verified": {
            "default": false,
            "title": "Verified",
            "type": "boolean"
          },
          "verify_method": {
            "anyOf": [
              {
                "enum": [
                  "quote_exact",
                  "quote_fuzzy",
                  "search_log"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verify Method"
          },
          "verify_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verify Note"
          }
        },
        "required": [
          "domain",
          "about",
          "text",
          "receipt"
        ],
        "title": "Claim",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "FastAPI's error envelope, named so the OpenAPI document shows it on 401/404/429/503.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "sha": {
            "title": "Sha",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "sha",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Me": {
        "additionalProperties": false,
        "description": "`GET /auth/me`: the signed-in person's email, the only profile value we keep besides\nGoogle's subject id.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "Me",
        "type": "object"
      },
      "QuoteReceipt": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "quote",
            "default": "quote",
            "title": "Kind",
            "type": "string"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "quote"
        ],
        "title": "QuoteReceipt",
        "type": "object"
      },
      "RunAccepted": {
        "description": "`202` body of `POST /api/runs`: the id to poll with `GET /api/runs/{run_id}`.",
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "RunAccepted",
        "type": "object"
      },
      "RunRequest": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "rival": {
            "title": "Rival",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "rival"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunSummary": {
        "additionalProperties": false,
        "properties": {
          "rival": {
            "title": "Rival",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "total_count": {
            "title": "Total Count",
            "type": "integer"
          },
          "verified_count": {
            "title": "Verified Count",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "subject",
          "rival",
          "status",
          "verified_count",
          "total_count",
          "started_at"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "SearchReceipt": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "search",
            "default": "search",
            "title": "Kind",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "query",
          "rank",
          "url",
          "ts"
        ],
        "title": "SearchReceipt",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Receipts",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/runs": {
      "get": {
        "description": "History, newest first: without a valid session cookie, the runs that belong to no user\n(passcode, Ask Receipts, seed); with one, that person's runs plus those same shared runs.",
        "operationId": "list_runs_api_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  },
                  "title": "Response List Runs Api Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Runs",
        "tags": [
          "runs"
        ]
      },
      "post": {
        "operationId": "start_run_api_runs_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Demo-Passcode",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Demo-Passcode"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Today's signed-out runs are used up."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Start Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "operationId": "get_run_api_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Battlecard"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "callback_auth_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "A sign-in check failed; names it."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Sign-in is not configured, or the users store failed (`user_store`)."
          }
        },
        "summary": "Callback",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "login_auth_login_get",
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Sign-in is not configured."
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "303": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    }
  }
}
