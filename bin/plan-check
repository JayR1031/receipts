#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
# Generated by agentic-standard new-project. Self-contained; edit freely.
"""Validate an orchestrator plan's task graph; --ready lists tasks that may start now."""
from __future__ import annotations
"""The orchestrator's task graph: parsed from a fenced TOML block, validated, updated in place."""


import fnmatch
import re
import tomllib
from dataclasses import dataclass
from typing import Any

STATES = ("planned", "running", "judging", "merged", "blocked")
BLOCK = re.compile(r"```toml plan-graph\n(.*?)\n```", re.S)


@dataclass(frozen=True)
class Task:
    id: str
    title: str
    scope: tuple[str, ...]
    deps: tuple[str, ...]
    parallel_safe: bool
    model: str
    exit: str
    state: str


def _block(text: str) -> re.Match[str]:
    match = BLOCK.search(text)
    if not match:
        raise ValueError("no plan-graph block (```toml plan-graph … ```) in this plan")
    return match


def _get_str(raw: dict[str, Any], key: str, default: str | None = None) -> str:
    value = raw.get(key, default) if default is not None else raw[key]
    return str(value)


def _get_str_tuple(raw: dict[str, Any], key: str) -> tuple[str, ...]:
    values = raw.get(key, [])
    return tuple(str(v) for v in values)


def _task_from_raw(raw: dict[str, Any]) -> Task:
    return Task(
        id=_get_str(raw, "id"),
        title=_get_str(raw, "title", ""),
        scope=_get_str_tuple(raw, "scope"),
        deps=_get_str_tuple(raw, "deps"),
        parallel_safe=bool(raw.get("parallel_safe", False)),
        model=_get_str(raw, "model", "opus"),
        exit=_get_str(raw, "exit", "bin/jig"),
        state=_get_str(raw, "state", "planned"),
    )


def parse_plan(text: str) -> list[Task]:
    data: dict[str, Any] = tomllib.loads(_block(text).group(1))
    raw_tasks: list[dict[str, Any]] = data.get("task", [])
    return [_task_from_raw(raw) for raw in raw_tasks]


def _globs_overlap(a: str, b: str) -> bool:
    a_widened = a.replace("**", "x/y")
    b_widened = b.replace("**", "x/y")
    return a == b or fnmatch.fnmatch(b_widened, a) or fnmatch.fnmatch(a_widened, b)


def _visit_deps(
    node: str, tasks: dict[str, Task], colour: dict[str, int], stack: list[str]
) -> list[str] | None:
    for dep in tasks[node].deps:
        if dep not in tasks:
            continue
        if colour.get(dep) == 1:
            return stack[stack.index(dep) :] + [dep]
        if colour.get(dep, 0) == 0:
            cycle = _visit(dep, tasks, colour, stack)
            if cycle is not None:
                return cycle
    return None


def _visit(
    node: str, tasks: dict[str, Task], colour: dict[str, int], stack: list[str]
) -> list[str] | None:
    colour[node] = 1
    stack.append(node)
    cycle = _visit_deps(node, tasks, colour, stack)
    if cycle is None:
        stack.pop()
        colour[node] = 2
    return cycle


def _find_cycle(tasks: dict[str, Task]) -> list[str] | None:
    colour: dict[str, int] = dict.fromkeys(tasks, 0)
    stack: list[str] = []
    for task_id in tasks:
        if colour.get(task_id, 0) == 0:
            cycle = _visit(task_id, tasks, colour, stack)
            if cycle is not None:
                return cycle
    return None


def _overlapping_globs(a: Task, b: Task) -> list[str]:
    return [f"{ga} ~ {gb}" for ga in a.scope for gb in b.scope if _globs_overlap(ga, gb)]


def _scope_conflicts(tasks: list[Task]) -> list[str]:
    safe = [t for t in tasks if t.parallel_safe]
    problems: list[str] = []
    for i, a in enumerate(safe):
        for b in safe[i + 1 :]:
            overlaps = _overlapping_globs(a, b)
            if overlaps:
                msg = f"parallel_safe tasks {a.id} and {b.id} overlap: {', '.join(overlaps)}"
                problems.append(msg)
    return problems


def _id_problems(tasks: list[Task]) -> list[str]:
    ids = [t.id for t in tasks]
    return [f"duplicate id {i}" for i in sorted({i for i in ids if ids.count(i) > 1})]


def _dep_and_state_problems(tasks: list[Task], by_id: dict[str, Task]) -> list[str]:
    problems: list[str] = []
    for t in tasks:
        problems += [f"{t.id} depends on unknown task {d}" for d in t.deps if d not in by_id]
        if t.id in t.deps:
            problems.append(f"{t.id} depends on itself")
        if t.state not in STATES:
            problems.append(f"{t.id} has unknown state {t.state!r}; allowed {STATES}")
    return problems


def validate_graph(tasks: list[Task]) -> list[str]:
    by_id = {t.id: t for t in tasks}
    problems = _id_problems(tasks) + _dep_and_state_problems(tasks, by_id)
    cycle = _find_cycle(by_id)
    if cycle is not None:
        problems.append("cycle: " + " -> ".join(cycle))
    return problems + _scope_conflicts(tasks)


def ready_tasks(tasks: list[Task]) -> list[Task]:
    by_id = {t.id: t for t in tasks}
    return [
        t
        for t in tasks
        if t.state == "planned" and all(by_id[d].state == "merged" for d in t.deps if d in by_id)
    ]


def set_state(text: str, task_id: str, state: str) -> str:
    if state not in STATES:
        raise ValueError(f"state {state!r} not in {STATES}")
    match = _block(text)
    chunks = re.split(r"(?=^\[\[task\]\])", match.group(1), flags=re.M)
    for i, chunk in enumerate(chunks):
        if re.search(rf'^id\s*=\s*"{re.escape(task_id)}"', chunk, re.M):
            chunks[i] = re.sub(r'^state\s*=\s*".*?"', f'state = "{state}"', chunk, flags=re.M)
    return text[: match.start(1)] + "".join(chunks) + text[match.end(1) :]


import argparse
import sys
from pathlib import Path



def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("plan", type=Path)
    ap.add_argument("--ready", action="store_true")
    args = ap.parse_args()
    tasks = parse_plan(args.plan.read_text(encoding="utf-8"))
    problems = validate_graph(tasks)
    for p in problems:
        print(f"problem: {p}")
    if args.ready and not problems:
        print("ready: " + (", ".join(t.id for t in ready_tasks(tasks)) or "none"))
    print(f"{len(tasks)} tasks, {len(problems)} problems")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
