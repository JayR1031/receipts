#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
# Generated by agentic-standard new-project. Self-contained; edit freely.
"""Run the deterministic loop for this repo. Exit non-zero at the first failing class."""
from __future__ import annotations
"""Plain-text tables for CLI reports."""


from collections.abc import Callable


def print_table(
    rows: list[tuple[str, ...]], headers: tuple[str, ...], write: Callable[[str], None] = print
) -> None:
    widths = [max(len(str(c)) for c in col) for col in zip(headers, *rows, strict=False)]
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    write(fmt.format(*headers))
    write(fmt.format(*("-" * w for w in widths)))
    for row in rows:
        write(fmt.format(*row))
"""The deterministic loop: format, lint, types, tests — stop at the first failing class."""


import shutil
import subprocess
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

Runner = Callable[..., subprocess.CompletedProcess[str]]
CLASSES = ("format", "lint", "types", "tests")

PY: dict[str, tuple[tuple[str, ...], tuple[str, ...]]] = {  # klass -> (check cmd, fix cmd)
    "format": (
        ("uv", "run", "ruff", "format", "--check", "."),
        ("uv", "run", "ruff", "format", "."),
    ),
    "lint": (("uv", "run", "ruff", "check", "."), ("uv", "run", "ruff", "check", "--fix", ".")),
    "types": (("uv", "run", "pyright"), ("uv", "run", "pyright")),
    "tests": (
        ("uv", "run", "pytest", "-q", "-m", "not integration"),
        ("uv", "run", "pytest", "-q", "-m", "not integration"),
    ),
    "integration": (
        ("uv", "run", "pytest", "-q", "-m", "integration"),
        ("uv", "run", "pytest", "-q", "-m", "integration"),
    ),
}
TS: dict[str, tuple[tuple[str, ...], tuple[str, ...]]] = {
    "format": (("pnpm", "run", "format:check"), ("pnpm", "run", "format")),
    "lint": (("pnpm", "run", "lint"), ("pnpm", "run", "lint:fix")),
    "types": (("pnpm", "run", "typecheck"), ("pnpm", "run", "typecheck")),
    "tests": (("pnpm", "run", "test"), ("pnpm", "run", "test")),
    "integration": (("pnpm", "run", "test:integration"), ("pnpm", "run", "test:integration")),
}
TABLES = {"python": PY, "typescript": TS}


@dataclass(frozen=True)
class StepResult:
    stack: str
    klass: str
    cmd: tuple[str, ...]
    returncode: int
    output: str


def detect_stacks(root: Path) -> tuple[str, ...]:
    found: list[str] = []
    if (root / "pyproject.toml").exists():
        found.append("python")
    if (root / "package.json").exists():
        found.append("typescript")
    return tuple(found)


def plan_steps(
    stacks: tuple[str, ...], *, fix: bool, scope: str
) -> list[tuple[str, str, tuple[str, ...]]]:
    classes = CLASSES + (("integration",) if scope == "all" else ())
    steps: list[tuple[str, str, tuple[str, ...]]] = []
    for klass in classes:
        for stack in stacks:
            check, fixer = TABLES[stack][klass]
            steps.append((stack, klass, fixer if fix else check))
    return steps


def wipe_caches(root: Path) -> int:
    dirs = [p for p in root.rglob("__pycache__") if p.is_dir() and ".venv" not in p.parts]
    for d in dirs:
        shutil.rmtree(d, ignore_errors=True)
    return len(dirs)


def _result(
    stack: str, klass: str, cmd: tuple[str, ...], proc: subprocess.CompletedProcess[str]
) -> StepResult:
    rc = proc.returncode
    note = ""
    if klass == "integration" and stack == "python" and rc == 5:  # pytest: no tests collected
        rc = 0
        note = "\n[jig] no integration tests collected — none ran (reported, not passed)"
    return StepResult(stack, klass, cmd, rc, proc.stdout + proc.stderr + note)


def run_jig(
    root: Path, *, fix: bool = False, scope: str = "unit", run: Runner = subprocess.run
) -> list[StepResult]:
    wipe_caches(root)
    results: list[StepResult] = []
    failed_class: str | None = None
    for stack, klass, cmd in plan_steps(detect_stacks(root), fix=fix, scope=scope):
        if failed_class is not None and klass != failed_class:
            break
        proc = run(list(cmd), cwd=root, capture_output=True, text=True)
        result = _result(stack, klass, cmd, proc)
        results.append(result)
        if result.returncode != 0:
            failed_class = klass
    return results


import argparse
import sys
from pathlib import Path



def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--fix", action="store_true", help="apply formatter and safe lint fixes")
    ap.add_argument("--scope", choices=("unit", "all"), default="unit")
    ap.add_argument("--root", type=Path, default=Path.cwd())
    args = ap.parse_args()
    results = run_jig(args.root, fix=args.fix, scope=args.scope)
    if not results:
        print("jig: no pyproject.toml or package.json here — nothing to run (this is not a pass)")
        return 2
    rows = [
        (r.stack, r.klass, "ok" if r.returncode == 0 else f"FAIL ({r.returncode})")
        for r in results
    ]
    print_table(rows, ("stack", "class", "result"))
    failed = [r for r in results if r.returncode != 0]
    for r in failed:
        print(f"\n--- {r.stack} {r.klass}: {' '.join(r.cmd)}\n{r.output}")
    return failed[0].returncode if failed else 0


if __name__ == "__main__":
    sys.exit(main())
