#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
# Generated by agentic-standard new-project. Self-contained; edit freely.
"""Plant a canary per gate, expect red, remove it, expect green. Exit 1 if any gate cannot fail."""
from __future__ import annotations
"""Plain-text tables for CLI reports."""


from collections.abc import Callable


def print_table(
    rows: list[tuple[str, ...]], headers: tuple[str, ...], write: Callable[[str], None] = print
) -> None:
    widths = [max(len(str(c)) for c in col) for col in zip(headers, *rows, strict=False)]
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    write(fmt.format(*headers))
    write(fmt.format(*("-" * w for w in widths)))
    for row in rows:
        write(fmt.format(*row))
"""Prove each installed gate can fail: plant a canary, expect red, remove it, expect green."""


import os
import secrets
import shutil
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass, field
from pathlib import Path
from typing import Protocol

Runner = Callable[..., subprocess.CompletedProcess[str]]


@dataclass(frozen=True)
class GateResult:
    gate: str
    planted_red: bool
    removed_green: bool
    detail: str
    skipped: str | None = None

    @property
    def ok(self) -> bool:
        return self.skipped is None and self.planted_red and self.removed_green


def _git(root: Path, *args: str) -> str:
    return subprocess.run(
        ["git", *args], cwd=root, check=True, capture_output=True, text=True
    ).stdout


def _restore_index_entry(root: Path, path: Path, entry: str) -> None:
    """Put one index entry back exactly: the staged blob it had, or no entry at all."""
    rel = str(path.relative_to(root))
    if not entry:
        _git(root, "rm", "--cached", "-q", "--ignore-unmatch", "--", rel)
        return
    mode, sha = entry.split()[:2]
    _git(root, "update-index", "--cacheinfo", f"{mode},{sha},{rel}")


@dataclass
class Planted:
    """What a plant touched, captured BEFORE the touch.

    Cleanup writes back these exact bytes and index entries; it never restores HEAD, so
    uncommitted (and staged) work in a planted file survives the red-test.
    """

    root: Path
    files: dict[Path, bytes | None] = field(default_factory=lambda: {})
    index: dict[Path, str] = field(default_factory=lambda: {})

    def keep(self, path: Path) -> None:
        if path not in self.files:
            self.files[path] = path.read_bytes() if path.exists() else None

    def stage(self, *paths: Path) -> None:
        for path in paths:
            if path not in self.index:
                self.index[path] = _git(self.root, "ls-files", "-s", "--", str(path)).strip()
        _git(self.root, "add", "--", *(str(p) for p in paths))

    def restore(self) -> None:
        for path, entry in self.index.items():
            _restore_index_entry(self.root, path, entry)
        for path, data in self.files.items():
            if data is None:
                path.unlink(missing_ok=True)
            else:
                path.write_bytes(data)


class Gate(Protocol):
    name: str

    def available(self, root: Path) -> str | None: ...
    def plant(self, root: Path, record: Planted) -> None: ...
    def check(self, root: Path, run: Runner) -> int: ...


class DenylistGate:
    name = "leak-gate (denylist)"
    canary = "RED-TEST-CANARY-" + secrets.token_hex(4)

    def available(self, root: Path) -> str | None:
        if (root / "scripts/leak_gate/check_tracked.py").exists():
            return None
        return "no scripts/leak_gate"

    def plant(self, root: Path, record: Planted) -> None:
        deny = root / "scripts/leak_gate/denylist.txt"
        planted = root / "red-test-planted.md"
        record.keep(deny)
        record.keep(planted)
        text = deny.read_text(encoding="utf-8")
        sep = "\n" if text and not text.endswith("\n") else ""  # never glue onto the last line
        deny.write_text(f"{text}{sep}{self.canary}\n", encoding="utf-8")
        planted.write_text(f"this line carries {self.canary}\n", encoding="utf-8")
        record.stage(deny, planted)

    def check(self, root: Path, run: Runner) -> int:
        return run(
            [sys.executable, "scripts/leak_gate/check_tracked.py"],
            cwd=root,
            capture_output=True,
            text=True,
        ).returncode


class GitleaksGate:
    name = "gitleaks"

    def available(self, root: Path) -> str | None:
        return None if shutil.which("gitleaks") else "gitleaks not installed"

    def plant(self, root: Path, record: Planted) -> None:
        alphabet = "abcdefghijklmnopqrstuvwxyz0123456789"
        fake = "ghp_" + "".join(secrets.choice(alphabet) for _ in range(36))
        planted = root / "red-test-planted.env"
        record.keep(planted)
        planted.write_text(f"GITHUB_TOKEN={fake}\n", encoding="utf-8")

    def check(self, root: Path, run: Runner) -> int:
        return run(
            ["gitleaks", "detect", "--source", ".", "--no-git", "--redact", "--exit-code", "1"],
            cwd=root,
            capture_output=True,
            text=True,
        ).returncode


class AuditGate:
    """Dependency audit must fail on a known-vulnerable pin.

    Needs network; skips by name offline.
    """

    name = "dependency-audit"

    def available(self, root: Path) -> str | None:
        if not (root / "pyproject.toml").exists():
            return "no pyproject.toml (npm audit is proven in CI, not here)"
        if os.environ.get("AGENTIC_OFFLINE"):
            return "AGENTIC_OFFLINE set"
        return None if shutil.which("uvx") else "uvx not installed"

    def plant(self, root: Path, record: Planted) -> None:
        planted = root / "red-test-requirements.txt"
        record.keep(planted)
        # CVE-2018-18074, long fixed; any auditor flags it
        planted.write_text("requests==2.19.0\n", encoding="utf-8")

    def check(self, root: Path, run: Runner) -> int:
        planted = root / "red-test-requirements.txt"
        if planted.exists():
            cmd = [
                "uvx",
                "pip-audit",
                "--strict",
                "--vulnerability-service",
                "osv",
                "-r",
                str(planted),
            ]
        else:
            cmd = ["uv", "run", "pip-audit", "--strict", "--vulnerability-service", "osv"]
        return run(cmd, cwd=root, capture_output=True, text=True).returncode


class NeutralityGate:
    name = "neutrality"

    def available(self, root: Path) -> str | None:
        if not (root / "tests/test_neutrality.py").exists():
            return "no tests/test_neutrality.py"
        return (
            None
            if (root / "tests/org_denylist.txt").exists()
            else "tests/org_denylist.txt missing (copy the example and fill it)"
        )

    def plant(self, root: Path, record: Planted) -> None:
        source = root / "tests/org_denylist.txt"
        pattern = next(
            ln for ln in source.read_text().splitlines() if ln.strip() and not ln.startswith("#")
        )
        readme = root / "README.md"
        record.keep(readme)
        readme.write_text(
            readme.read_text(encoding="utf-8") + f"\nplanted: {pattern}\n", encoding="utf-8"
        )

    def check(self, root: Path, run: Runner) -> int:
        return run(
            ["uv", "run", "pytest", "tests/test_neutrality.py", "-q", "-p", "no:cacheprovider"],
            cwd=root,
            capture_output=True,
            text=True,
        ).returncode


DENYLIST: Gate = DenylistGate()
GITLEAKS: Gate = GitleaksGate()
AUDIT: Gate = AuditGate()
NEUTRALITY: Gate = NeutralityGate()


def _run_one(root: Path, gate: Gate, run: Runner) -> GateResult:
    reason = gate.available(root)
    if reason:
        return GateResult(gate.name, False, False, reason, skipped=reason)
    record = Planted(root)
    try:  # plant is inside: a plant that fails halfway is still put back
        gate.plant(root, record)
        red = gate.check(root, run) != 0
    finally:
        record.restore()
    green = gate.check(root, run) == 0
    planted_desc = "non-zero" if red else "0 (gate did not fire)"
    removed_desc = "0" if green else "non-zero"
    detail = f"planted → exit {planted_desc}; removed → {removed_desc}"
    return GateResult(gate.name, red, green, detail)


def run_gates(root: Path, gates: list[Gate], run: Runner = subprocess.run) -> list[GateResult]:
    return [_run_one(root, g, run) for g in gates]


import argparse
import sys
from pathlib import Path



def main() -> int:
    argparse.ArgumentParser(description=__doc__).parse_args()  # only --help; keeps the CLI uniform
    root = Path.cwd()
    gates = [GITLEAKS, DENYLIST, AUDIT] + (
        [NEUTRALITY] if (root / "tests/test_neutrality.py").exists() else []
    )
    results = run_gates(root, gates)
    rows = [
        (
            r.gate,
            "skipped: " + r.skipped if r.skipped else ("red→green" if r.ok else "NOT PROVEN"),
            r.detail,
        )
        for r in results
    ]
    print_table(rows, ("gate", "result", "detail"))
    unproven = [r for r in results if r.skipped is None and not r.ok]
    skipped = [r for r in results if r.skipped]
    if skipped:
        names = ", ".join(r.gate for r in skipped)
        print(f"\n{len(skipped)} gate(s) skipped, not passed: {names}")
    return 1 if unproven else 0


if __name__ == "__main__":
    sys.exit(main())
